OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model name used by the recipe agent and intent-decision client.
DEPLOYMENT_NAME=your-model-name

FLASK_APP=tdapp
FLASK_RUN_PORT=5000
LANGSERVE_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=your-database-name

# PostgreSQL database for persistent LangGraph conversation checkpoints.
LANGGRAPH_POSTGRES_URI=postgresql://your-postgres-user:your-postgres-password@your-postgres-host:your-postgres-port/your-postgres-database